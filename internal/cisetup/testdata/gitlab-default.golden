provider: gitlab (GitLab CI)
=== create .gitlab/gravity.yml
gravity:
  image: alpine:3.20
  variables:
    GIT_DEPTH: '0'
  before_script:
    - apk add --no-cache git curl
    - curl -fsSL https://app.gravitydocs.io/install.sh | GRAVITY_VERSION=1 sh
  script:
    - gravity run
  artifacts:
    when: always
    paths:
      - gravity-report.md
    reports:
      codequality: gl-code-quality-report.json
  rules:
    - if: $CI_PIPELINE_SOURCE == "merge_request_event"
    - if: $CI_COMMIT_BRANCH == $CI_DEFAULT_BRANCH
    - if: $CI_COMMIT_TAG
    - if: $CI_PIPELINE_SOURCE == "schedule"
=== create .gitlab-ci.yml
include:
  - local: .gitlab/gravity.yml
=== paste: add it as the masked CI/CD variable GRAVITY_REPO_TOKEN at https://gitlab.com/acme/billing-api/-/settings/ci_cd (Variables)
