provider: bitbucket (Bitbucket Pipelines)
=== create bitbucket-pipelines.yml
image: alpine:3.20
clone:
  depth: full
definitions:
  steps:
    - step: &gravity
        name: Gravity
        script:
          - apk add --no-cache git curl
          - curl -fsSL https://app.gravitydocs.io/install.sh | GRAVITY_VERSION=1 sh
          - export GRAVITY_API_URL=https://api.acme.test
          - gravity run
pipelines:
  branches:
    trunk:
      - step: *gravity
  pull-requests:
    '**':
      - step: *gravity
  tags:
    'v*':
      - step: *gravity
  custom:
    gravity-schedule:
      - step:
          name: Gravity (schedule)
          script:
            - apk add --no-cache git curl
            - curl -fsSL https://app.gravitydocs.io/install.sh | GRAVITY_VERSION=1 sh
            - export GRAVITY_API_URL=https://api.acme.test
            - GRAVITY_TRIGGER=schedule gravity run
=== paste: add it as the secured repository variable GRAVITY_TOKEN (Repository settings > Pipelines > Repository variables)
