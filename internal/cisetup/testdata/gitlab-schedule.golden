provider: gitlab (GitLab CI)
=== create .gitlab/gravity.yml
gravity:
  image: alpine:3.20
  variables:
    GIT_DEPTH: '0'
    GRAVITY_API_URL: 'https://api.acme.test'
  before_script:
    - apk add --no-cache git curl
    - curl -fsSL https://app.gravitydocs.io/install.sh | GRAVITY_VERSION=1 sh
  script:
    - gravity run
  rules:
    - if: $CI_PIPELINE_SOURCE == "merge_request_event"
    - if: $CI_COMMIT_BRANCH == $CI_DEFAULT_BRANCH
    - if: $CI_COMMIT_TAG
    - if: $CI_PIPELINE_SOURCE == "schedule"
=== create .gitlab-ci.yml
include:
  - local: .gitlab/gravity.yml
=== paste: add it as the masked CI/CD variable GRAVITY_TOKEN (Settings > CI/CD > Variables)
