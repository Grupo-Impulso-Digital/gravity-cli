provider: github (GitHub Actions)
=== create .github/workflows/gravity.yml
name: Gravity
on:
  push:
    branches: [main]
  pull_request:
  release:
    types: [published]
  workflow_dispatch:
permissions:
  contents: read
  pull-requests: write
jobs:
  gravity:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 0
      - uses: Grupo-Impulso-Digital/gravity-cli/ci/github@v1
        with:
          token: ${{ secrets.GRAVITY_REPO_TOKEN || secrets.GRAVITY_TOKEN }}
=== paste: add it as the repository secret GRAVITY_REPO_TOKEN at https://github.com/acme/billing-api/settings/secrets/actions/new
