version: 2
product: acme-platform
apiUrl: https://api.gravitydocs.io
code:
  openapi: [api/openapi.yaml, api/admin.yaml]
  entrypoints: [src/routes]
  include: [src/**]
  exclude: [src/**/*.test.ts]
  units:
    kind: feature
passes:
  - name: docs
    kind: guides
    template: user-guide
    target: acme/product
    triggers: [push, pr]
    audiences: [users]
    options:
      languages: [fr, de]
  - name: guides-platform
    kind: guides
    template: user-guide
    target: acme/platform/billing-api
    triggers: [push, pr]
    audiences: [users]
    options:
      languages: [fr, de]
  - name: api-api
    kind: reference
    template: api-reference
    target: acme/api
    triggers: [push, pr]
    options:
      languages: [fr, de]
      sources:
        - path: api/openapi.yaml
          page: billing-api
          title: Billing API
          collection: reference
        - path: api/admin.yaml
  - name: docs-product
    kind: verbatim
    target: acme/product
    triggers: [push]
    audiences: [users]
    options:
      adopt: true
      files:
        - include: docs/guide.md
          slug: guide
          title: Guide
        - include: docs/faq.md
          collection: help
      languages: [fr, de]
  - name: changelog
    kind: changelog
    template: customer-changelog
    target: acme/changelog
    triggers: [release]
    options:
      changelogFile: CHANGELOG.md
      source: changelog-file
  - name: memory
    kind: nucleus
    template: nucleus-facts
    triggers: [push]
    options:
      namespace: product:acme-platform/billing
  - name: pr-check
    kind: check
    triggers: [pr]
    options:
      coverageMin: 0.8
      failOn: [drift, claims, verbatim, coverage]
      require: [checkout, api]
---
mapped version: version: 2
mapped site: prefix of every pass target (acme/...)
mapped apiUrl: apiUrl
mapped product.slug: product: acme-platform (normalized from "Acme Platform")
dropped product.repo: repository identity comes from the git remote (billing is used only when there is no remote)
mapped discovery.include: code.include
mapped discovery.exclude: code.exclude
mapped discovery.entrypoints: code.entrypoints
mapped product.role: code.units.kind: feature
mapped discovery.units: code.units.kind: feature
mapped discovery.audiences.default: audiences of the generated guides passes
mapped spaces.default: guides pass docs (user-guide) -> acme/product
mapped spaces.shared: guides passes into this repository's collection of each shared space: acme/platform/billing-api
dropped spaces.parent: space structure is app state (was root)
dropped spaces.home: pinned pages are app state (was overview)
mapped i18n.languages: options.languages on every guides, reference and verbatim pass
mapped sources: reference passes api-api; each source path added to code.openapi
dropped sources[].kind: kind code sources were already rejected by v1
dropped sources[].generator: dead key
mapped documents: verbatim passes docs-product with adopt: true and per-file slug/title overrides; the pages become repo-locked once their import is accepted
dropped documents[].ownership: verbatim pages are machine-owned and locked (v1 ownership: human pages were editable in Gravity)
dropped documents[].version: versions are git history
dropped releaseNotes.changelog: dead key
mapped documents[].as: the as: release document CHANGELOG.md is the changelog pass's changelogFile
mapped releaseNotes.space: changelog pass changelog (customer-changelog) -> acme/changelog, reading CHANGELOG.md
dropped knowledge.scope: dead key
mapped knowledge.namespace: nucleus pass memory with options.namespace: product:acme-platform/billing
mapped coverage.min: check pass pr-check options.coverageMin: 0.8 (from 80%)
mapped coverage.require: check pass pr-check options.require
mapped spaces.declare: spaces product, api are created in Gravity by init when missing; their audiences apply to the passes targeting them
declare acme/product Product docs product-docs  parent=
declare acme/api API api-reference public parent=product
