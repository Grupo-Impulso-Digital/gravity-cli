version: 2
product: gravity
apiUrl: https://api.gravitydocs.io
code:
  entrypoints: [cmd/gravity/main.go, internal/cli/root.go, internal/config/project.go]
  exclude: [dist/**, '**/*_test.go']
  units:
    kind: capability
passes:
  - name: docs
    kind: guides
    template: user-guide
    target: gravity/cli
    triggers: [push, pr]
    audiences: [developers]
    options:
      languages: [fr]
  - name: guides-internal
    kind: guides
    template: user-guide
    target: gravity/internal/billing-api
    triggers: [push, pr]
    audiences: [developers]
    options:
      languages: [fr]
  - name: docs-internal
    kind: verbatim
    target: gravity/internal
    triggers: [push]
    options:
      adopt: true
      files:
        - include: docs/platform-authoring-api.md
          slug: platform-authoring-api
          title: Platform authoring API (CLI-side contract mirror)
      languages: [fr]
  - name: changelog
    kind: changelog
    template: customer-changelog
    target: gravity/changelog
    triggers: [release]
  - name: memory
    kind: nucleus
    template: nucleus-facts
    triggers: [push]
  - name: pr-check
    kind: check
    triggers: [pr]
    options:
      coverageMin: 0.7
      failOn: [drift, claims, verbatim, coverage]
      require: [overview]
---
mapped version: version: 2
mapped site: prefix of every pass target (gravity/...)
mapped apiUrl: apiUrl
mapped product.slug: product: gravity
dropped product.repo: repository identity comes from the git remote (cli is used only when there is no remote)
mapped discovery.exclude: code.exclude
mapped discovery.entrypoints: code.entrypoints
mapped discovery.units: code.units.kind: capability
mapped discovery.audiences.default: audiences of the generated guides passes
mapped spaces.default: guides pass docs (user-guide) -> gravity/cli
mapped spaces.shared: guides passes into this repository's collection of each shared space: gravity/internal/billing-api
dropped spaces.parent: space structure is app state (was developers)
dropped spaces.home: pinned pages are app state (was overview)
mapped i18n.languages: options.languages on every guides, reference and verbatim pass
mapped documents: verbatim passes docs-internal with adopt: true and per-file slug/title overrides; the pages become repo-locked once their import is accepted
dropped documents[].ownership: verbatim pages are machine-owned and locked (v1 ownership: human pages were editable in Gravity)
mapped releaseNotes.space: changelog pass changelog (customer-changelog) -> gravity/changelog
dropped knowledge.namespace: nucleus pass memory writes to the product namespace product:gravity; "gravity" is not inside it
mapped coverage.min: check pass pr-check options.coverageMin: 0.7
mapped coverage.require: check pass pr-check options.require
mapped spaces.declare: spaces developers, cli, internal are created in Gravity by init when missing; their audiences apply to the passes targeting them
declare gravity/developers Developers api-reference public parent=
declare gravity/cli CLI   parent=developers
declare gravity/internal Engineering Handbook handbook private parent=
