# Bitbucket Pipelines example for the Gravity CLI.
#
# Place this content in bitbucket-pipelines.yml at the root of your docs/code
# repository. Add GRAVITY_TOKEN as a SECURED repository variable (Repository
# settings > Repository variables). Site, spaces and API URL come from the
# committed .gravity.yaml; set GRAVITY_SITE / GRAVITY_API_URL only to override.
#
# Cadence (see ci/README.md):
#   pull request     check docs + check api        read-only
#   push to main     ping -> sync -> docs generate --since <last green sha>
#   tag v*           release-notes
#
# Exit-code convention: 0 pass, 1 findings, 2 error, 3 licence refusal. The
# pull-request steps let findings fail the build so drift is visible; the
# branch/tag steps swallow exit 1 (`|| [ $? -eq 1 ]`) because documentation
# drift must never gate a deploy, while a broken setup still fails.

image: buildpack-deps:bookworm-scm

# release-notes, `check docs --ai` and `--since` all walk git history.
clone:
  depth: full

definitions:
  caches:
    gravity: .gravity-bin
  steps:
    - step: &gravity-check-docs
        name: Gravity docs check
        caches: [gravity]
        script:
          - &install-gravity |
            # Prebuilt release binary (checksum-verified by the installer).
            # Pin GRAVITY_CLI_VERSION (e.g. v0.3.0) as a repository variable
            # for reproducible pipelines; the default follows the newest 0.x release.
            VERSION="${GRAVITY_CLI_VERSION:-0}"
            if [ ! -x .gravity-bin/gravity ] || ! printf '%s' "$VERSION" | grep -Eq '^v?[0-9]+[.][0-9]+[.][0-9]+$'; then
              curl -fsSL https://raw.githubusercontent.com/Grupo-Impulso-Digital/gravity-cli/main/install.sh \
                | GRAVITY_VERSION="$VERSION" GRAVITY_INSTALL_DIR="$BITBUCKET_CLONE_DIR/.gravity-bin" sh
            fi
            export PATH="$BITBUCKET_CLONE_DIR/.gravity-bin:$PATH"
            gravity version
          # GRAVITY_TOKEN is injected from the secured repository variable.
          - gravity check docs --ci --format text

    - step: &gravity-check-api
        name: Gravity API drift check
        caches: [gravity]
        script:
          - *install-gravity
          # Diffs every OpenAPI spec mapped under `sources` in .gravity.yaml;
          # with none, verifies each api block's source-binding hash.
          - gravity check api --ci --format text

    - step: &gravity-sync
        name: Gravity sync
        caches: [gravity]
        # Bitbucket serializes steps that target the same deployment
        # environment. Create one named gravity-docs-live in repository settings
        # and uncomment this so two pushes cannot race on page attribution
        # (last-writer-wins) or on the declarative inventory.
        # deployment: gravity-docs-live
        script:
          - *install-gravity
          # ping registers/refreshes this repo (branch, commit, manifest) so
          # attribution and coverage see the right revision.
          - gravity ping --ci
          # sync first: it shapes spaces/collections/home pages so generated
          # pages land in an existing structure.
          - gravity sync --ci || [ $? -eq 1 ]

    - step: &gravity-generate
        name: Gravity docs generate
        caches: [gravity]
        script:
          - *install-gravity
          # The incremental base is the previous SUCCESSFUL run's commit, never
          # HEAD~1 — a failed or skipped run must not leave a permanent gap. The
          # step reads a `docs-synced` marker tag; with no tag it falls back to
          # a full survey, which is always correct, only slower.
          - git fetch --tags --force --quiet || true
          - SINCE="$(git rev-parse --verify --quiet 'docs-synced^{commit}' || true)"
          - if [ -n "$SINCE" ]; then gravity docs generate --ci --since "$SINCE" || [ $? -eq 1 ]; else gravity docs generate --ci || [ $? -eq 1 ]; fi
          # Move the marker on success (Pipelines can push to its own repo).
          - git tag -f docs-synced "$BITBUCKET_COMMIT"
          - git push -f origin refs/tags/docs-synced
          # --min defaults to coverage.min from .gravity.yaml.
          - gravity coverage --ci --format text || [ $? -eq 1 ]

pipelines:
  pull-requests:
    "**":
      - step: *gravity-check-docs
      - step: *gravity-check-api
  branches:
    main:
      - step: *gravity-sync
      - step: *gravity-generate
  tags:
    "v*":
      - step:
          name: Gravity release notes
          caches: [gravity]
          script:
            - *install-gravity
            # Lands in releaseNotes.space from .gravity.yaml (default: changelog).
            - gravity release-notes --ci --output proposal || [ $? -eq 1 ]
